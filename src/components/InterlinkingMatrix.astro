---
import { Keyboard, Receipt, Sparkles, CircleDot, BookOpen, FileText, ArrowRight, Bookmark, Globe2, ListOrdered, Scale } from "lucide-react";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const normCurrent = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

const isFontSilo = normCurrent.startsWith("/letras-aesthetic/") || 
                   normCurrent.startsWith("/letras-burbuja/") ||
                   normCurrent.includes("letras-burbuja") ||
                   normCurrent.includes("letras-aesthetic");

// Number Silo Tools
const numberTools = [
  {
    id: "/",
    href: "/",
    title: "Convertidor General de Números a Letras",
    desc: "Herramienta general para transcribir cualquier cifra entera o decimal a palabras en español.",
    icon: Keyboard,
    color: "text-blue-600 bg-blue-50 border-blue-100"
  },
  {
    id: "/cantidad-con-letra/",
    href: "/cantidad-con-letra/",
    title: "Conversor de Cantidad con Letra",
    desc: "Escribe importes monetarios con centavos y fracciones para cheques, pagarés y contratos.",
    icon: Receipt,
    color: "text-emerald-600 bg-emerald-50 border-emerald-100"
  },
  {
    id: "/como-se-escribe/",
    href: "/como-se-escribe/",
    title: "Guía de Ortografía RAE de Números",
    desc: "Aprende las reglas académicas para números compuestos, concordancia y escritura de cifras.",
    icon: BookOpen,
    color: "text-amber-600 bg-amber-50 border-amber-100"
  },
  {
    id: "/numeros/",
    href: "/numeros/",
    title: "Directorio Temático de Números",
    desc: "Consultas de números frecuentes, decenas, centenas, millares y millones en palabras.",
    icon: ListOrdered,
    color: "text-indigo-600 bg-indigo-50 border-indigo-100"
  }
];

// Country Currency Pages
const countryTools = [
  { href: "/cantidad-con-letra/mexico/", name: "México", code: "MXN", format: "Pesos 00/100 M.N.", flag: "🇲🇽" },
  { href: "/cantidad-con-letra/colombia/", name: "Colombia", code: "COP", format: "Pesos M/CTE", flag: "🇨🇴" },
  { href: "/cantidad-con-letra/peru/", name: "Perú", code: "PEN", format: "Soles y céntimos", flag: "🇵🇪" },
  { href: "/cantidad-con-letra/argentina/", name: "Argentina", code: "ARS", format: "Pesos con centavos", flag: "🇦🇷" },
  { href: "/cantidad-con-letra/espana/", name: "España", code: "EUR", format: "Euros con céntimos", flag: "🇪🇸" }
];

// Font Silo Tools
const fontTools = [
  {
    id: "/letras-aesthetic/",
    href: "/letras-aesthetic/",
    title: "Letras Aesthetic Copiar y Pegar",
    desc: "Genera fuentes bonitas, cursivas, góticas y símbolos para personalizar tus biografías y perfiles.",
    icon: Sparkles,
    color: "text-purple-600 bg-purple-50 border-purple-100"
  },
  {
    id: "/letras-burbuja/",
    href: "/letras-burbuja/",
    title: "Generador de Letras Burbuja",
    desc: "Convierte tus textos en caracteres con círculos blancos y negros Unicode para nicks y estados.",
    icon: CircleDot,
    color: "text-indigo-600 bg-indigo-50 border-indigo-100"
  }
];

const numberArticles = [
  {
    href: "/blog/guia-convertir-numeros-a-letras-rae-finanzas/",
    title: "Guía Suprema: Cómo Convertir Números a Letras en Español",
    desc: "Reglas ortográficas de la RAE, redacción financiera y el uso de 'mil' frente a 'un mil'."
  },
  {
    href: "/fuentes-y-metodologia/",
    title: "Fuentes y Metodología de Conversión",
    desc: "Documentación lingüística oficial y prácticas bancarias utilizadas por el conversor."
  }
];

const fontArticles = [
  {
    href: "/blog/arte-letras-burbuja-tipografia-circular-copiar-pegar/",
    title: "El Arte de las Letras Burbuja en Redes Sociales",
    desc: "Cómo funciona la codificación Unicode de los círculos y consejos para mejorar tus biografías."
  },
  {
    href: "/blog/letras-aesthetic-fuentes-pequenas-instagram-tiktok/",
    title: "Guía de Letras Aesthetic y Fuentes Pequeñas",
    desc: "Aprende a captar atención visual usando letras pequeñas versalitas y símbolos en tu bio."
  }
];
---

<section class="mt-12 bg-white rounded-3xl border border-gray-150 p-6 sm:p-8 text-left space-y-8 shadow-xs">
  {isFontSilo ? (
    <div class="space-y-8">
      <header class="border-b border-gray-100 pb-4">
        <h3 class="font-display font-bold text-gray-950 text-base sm:text-lg flex items-center gap-2.5">
          <span class="p-1.5 bg-purple-50 rounded-xl text-purple-600"><Sparkles className="w-5 h-5" /></span>
          <span>Tipografías y Recursos de Diseño Digital</span>
        </h3>
        <p class="text-xs text-gray-500 mt-1 leading-relaxed">
          Explora herramientas de tipografía estilizada para copiar y pegar en redes sociales, mensajería y perfiles.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-4">
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-1 font-mono">Herramientas de Tipografía</h4>
          <div class="grid grid-cols-1 gap-4">
            {fontTools.map((tool) => {
              const Icon = tool.icon;
              const isCurrent = normCurrent === tool.id;
              return (
                <a
                  href={tool.href}
                  class={`group p-4 rounded-2xl border transition-all duration-300 flex flex-col justify-between ${
                    isCurrent 
                      ? "border-purple-500 bg-purple-50/10 shadow-xs ring-2 ring-purple-500/5 cursor-default" 
                      : "border-gray-150 hover:border-gray-300 hover:bg-gray-50/50 hover:shadow-xs"
                  }`}
                >
                  <div class="space-y-2">
                    <div class="flex items-center gap-2.5">
                      <div class={`p-1.5 rounded-lg border ${tool.color}`}>
                        <Icon className="w-4 h-4" />
                      </div>
                      <span class="font-sans font-bold text-xs sm:text-sm text-gray-900 group-hover:text-purple-600 transition-colors">
                        {tool.title}
                      </span>
                    </div>
                    <p class="text-xs text-gray-500 leading-relaxed font-sans">
                      {tool.desc}
                    </p>
                  </div>
                  {!isCurrent && (
                    <div class="flex items-center gap-1 text-[10px] font-bold text-purple-600 mt-3 group-hover:translate-x-0.5 transition-transform">
                      <span>Usar generador</span>
                      <ArrowRight className="w-3 h-3" />
                    </div>
                  )}
                  {isCurrent && (
                    <div class="text-[9px] font-mono font-bold text-purple-500 bg-purple-50 px-2 py-0.5 rounded-md self-start mt-3">
                      Herramienta Actual
                    </div>
                  )}
                </a>
              );
            })}
          </div>
        </div>

        <div class="space-y-4">
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-1 font-mono">Guías de Diseño</h4>
          <div class="space-y-3">
            {fontArticles.map((article) => (
              <a
                href={article.href}
                class="group block p-4 rounded-2xl border border-gray-150 hover:border-gray-300 hover:bg-gray-50/50 hover:shadow-xs transition-all duration-300"
              >
                <div class="space-y-1.5 text-left">
                  <div class="flex items-center gap-1.5 text-[9px] font-mono font-bold text-purple-600 uppercase tracking-wider">
                    <FileText className="w-3 h-3" />
                    <span>Guía tipográfica</span>
                  </div>
                  <h5 class="font-sans font-bold text-xs text-gray-900 group-hover:text-purple-600 transition-colors line-clamp-2">
                    {article.title}
                  </h5>
                  <p class="text-[11px] text-gray-500 leading-relaxed font-sans line-clamp-2">
                    {article.desc}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400">
        <span>¿Necesitas convertir cifras numéricas?</span>
        <a href="/" class="text-blue-600 hover:underline font-medium">Ir al conversor de números a letras →</a>
      </div>
    </div>
  ) : (
    <div class="space-y-8">
      <header class="border-b border-gray-100 pb-4">
        <h3 class="font-display font-bold text-gray-950 text-base sm:text-lg flex items-center gap-2.5">
          <span class="p-1.5 bg-blue-50 rounded-xl text-blue-600"><Bookmark className="w-5 h-5" /></span>
          <span>Ecosistema de Conversión Numérica y Financiera</span>
        </h3>
        <p class="text-xs text-gray-500 mt-1 leading-relaxed">
          Herramientas didácticas de transcripción numérica, normativas de la RAE y formatos de divisas bancarias por país.
        </p>
      </header>

      <!-- Country Amount Converters Grid (P0 SEO + GEO) -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-1 font-mono flex items-center gap-1.5">
            <Globe2 className="w-3.5 h-3.5 text-blue-500" />
            <span>Cantidad con Letra por País (Moneda Local y Cheques)</span>
          </h4>
          <span class="text-[10px] text-gray-400 font-mono">Formatos adaptados</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5">
          {countryTools.map((c) => {
            const isCurrent = normCurrent === c.href;
            return (
              <a
                href={c.href}
                class={`p-3 rounded-2xl border transition-all text-left flex flex-col justify-between ${
                  isCurrent
                    ? "border-blue-500 bg-blue-50/20 shadow-xs ring-2 ring-blue-500/5 cursor-default"
                    : "border-gray-150 hover:border-blue-300 hover:bg-blue-50/10 hover:shadow-xs"
                }`}
              >
                <div>
                  <div class="flex items-center gap-1.5 mb-1">
                    <span class="text-base">{c.flag}</span>
                    <span class="font-sans font-bold text-xs text-gray-900">{c.name}</span>
                  </div>
                  <span class="inline-block text-[9px] font-mono font-semibold bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded">
                    {c.code}
                  </span>
                </div>
                <p class="text-[10px] text-gray-500 mt-2 font-mono leading-tight truncate">
                  {c.format}
                </p>
              </a>
            );
          })}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
        <!-- Core tools column -->
        <div class="md:col-span-2 space-y-4">
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-1 font-mono">Herramientas Principales</h4>
          <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {numberTools.map((tool) => {
              const Icon = tool.icon;
              const isCurrent = normCurrent === tool.id;
              return (
                <a
                  href={tool.href}
                  class={`group p-4 rounded-2xl border transition-all duration-300 flex flex-col justify-between ${
                    isCurrent 
                      ? "border-blue-500 bg-blue-50/10 shadow-xs ring-2 ring-blue-500/5 cursor-default" 
                      : "border-gray-150 hover:border-gray-300 hover:bg-gray-50/50 hover:shadow-xs"
                  }`}
                >
                  <div class="space-y-2">
                    <div class="flex items-center gap-2.5">
                      <div class={`p-1.5 rounded-lg border ${tool.color}`}>
                        <Icon className="w-4 h-4" />
                      </div>
                      <span class="font-sans font-bold text-xs sm:text-sm text-gray-900 group-hover:text-blue-600 transition-colors">
                        {tool.title}
                      </span>
                    </div>
                    <p class="text-xs text-gray-500 leading-relaxed font-sans">
                      {tool.desc}
                    </p>
                  </div>
                  {!isCurrent && (
                    <div class="flex items-center gap-1 text-[10px] font-bold text-blue-600 mt-3 group-hover:translate-x-0.5 transition-transform">
                      <span>Usar herramienta</span>
                      <ArrowRight className="w-3 h-3" />
                    </div>
                  )}
                  {isCurrent && (
                    <div class="text-[9px] font-mono font-bold text-blue-500 bg-blue-50 px-2 py-0.5 rounded-md self-start mt-3">
                      Herramienta Actual
                    </div>
                  )}
                </a>
              );
            })}
          </nav>
        </div>

        <!-- Featured articles section -->
        <div class="space-y-4">
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-1 font-mono">Documentación y Guías</h4>
          <div class="space-y-3">
            {numberArticles.map((article) => (
              <a
                href={article.href}
                class="group block p-4 rounded-2xl border border-gray-150 hover:border-gray-300 hover:bg-gray-50/50 hover:shadow-xs transition-all duration-300"
              >
                <div class="space-y-1.5 text-left">
                  <div class="flex items-center gap-1.5 text-[9px] font-mono font-bold text-blue-600 uppercase tracking-wider">
                    <FileText className="w-3 h-3" />
                    <span>Referencia educativa</span>
                  </div>
                  <h5 class="font-sans font-bold text-xs text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-2">
                    {article.title}
                  </h5>
                  <p class="text-[11px] text-gray-500 leading-relaxed font-sans line-clamp-2">
                    {article.desc}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Popular Search Queries for Numbers -->
      <div class="pt-6 border-t border-gray-100 space-y-4">
        <div class="space-y-2">
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-1 font-mono">
            Consultas Populares de Números en Letras
          </h4>
          <div class="flex flex-wrap gap-1.5 text-[11px] font-sans">
            <a href="/?n=100" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              100 (Cien)
            </a>
            <a href="/?n=500" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              500 (Quinientos)
            </a>
            <a href="/?n=1000" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              1000 (Mil)
            </a>
            <a href="/?n=1500" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              1500 (Mil quinientos)
            </a>
            <a href="/?n=2000" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              2000 (Dos mil)
            </a>
            <a href="/?n=5000" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              5000 (Cinco mil)
            </a>
            <a href="/?n=10000" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              10,000 (Diez mil)
            </a>
            <a href="/?n=50000" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              50,000 (Cincuenta mil)
            </a>
            <a href="/?n=100000" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              100,000 (Cien mil)
            </a>
            <a href="/?n=1000000" class="px-2.5 py-1 rounded-md bg-blue-50/60 hover:bg-blue-100 text-blue-800 font-medium transition-colors">
              1,000,000 (Un millón)
            </a>
          </div>
        </div>

        <div class="space-y-2">
          <h4 class="text-xs font-bold text-gray-400 uppercase tracking-widest pl-1 font-mono">
            Búsquedas Frecuentes y Guías Temáticas
          </h4>
          <div class="flex flex-wrap gap-2 text-xs font-sans">
            <a href="/cantidad-con-letra/" class="px-3 py-1.5 rounded-lg bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 text-gray-700 hover:text-blue-600 transition-colors">
              • ¿Cómo escribir montos para cheques?
            </a>
            <a href="/como-se-escribe/" class="px-3 py-1.5 rounded-lg bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 text-gray-700 hover:text-blue-600 transition-colors">
              • ¿Se escribe "Un mil" o "Mil"?
            </a>
            <a href="/como-se-escribe/" class="px-3 py-1.5 rounded-lg bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 text-gray-700 hover:text-blue-600 transition-colors">
              • Reglas del 21 al 29 en una sola palabra
            </a>
            <a href="/numeros/" class="px-3 py-1.5 rounded-lg bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 text-gray-700 hover:text-blue-600 transition-colors">
              • Guía completa de números cardinales
            </a>
            <a href="/cantidad-con-letra/" class="px-3 py-1.5 rounded-lg bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 text-gray-700 hover:text-blue-600 transition-colors">
              • Expresión de decimales y centavos (XX/100)
            </a>
            <a href="/fuentes-y-metodologia/" class="px-3 py-1.5 rounded-lg bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 text-gray-700 hover:text-blue-600 transition-colors">
              • Metodología de cálculo y fuentes RAE
            </a>
          </div>
        </div>
      </div>
    </div>
  )}
</section>

