---
import Layout from '../layouts/Layout.astro';
import { AboutUs } from '../components/LegalPages';

const title = "Quiénes Somos | numerosenletras.org";
const description = "Conoce el motor técnico, la rigurosa precisión lingüística y los valores de precisión que impulsan nuestro convertidor de números a letras.";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Quiénes Somos | numerosenletras.org",
  "url": "https://numerosenletras.org/sobre-nosotros",
  "description": description
};
---

<Layout title={title} description={description} currentPath="/sobre-nosotros" schemaData={schemaData}>
  <AboutUs client:load />
</Layout>
