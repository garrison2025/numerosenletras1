---
import { Image } from "astro:assets";
import { BLOG_POSTS } from '../../data/blog';
import Layout from '../../layouts/Layout.astro';

const title = "Blog Oficial | Guías de Ortografía, Finanzas y Redacción de Números";
const description = "Aprende las normas oficiales de la RAE para escribir números en letras, cómo llenar cheques correctamente y el uso de letras aesthetic y burbuja en redes sociales.";
const keywords = "blog oficial, guias ortograficas, finanzas, numeros a letras, como llenar cheques, letras burbuja, letras aesthetic";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog Oficial de numerosenletras.org",
  "url": "https://numerosenletras.org/blog",
  "description": description
};

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Blog", path: "/blog" }
];
---

<Layout title={title} description={description} keywords={keywords} currentPath="/blog" schemaData={schemaData} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto px-4 py-8 sm:py-14 animate-fade-in text-left">
    <!-- Header -->
    <header class="text-center mb-12">
      <div class="inline-flex items-center space-x-2 bg-blue-50 text-blue-700 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-4 border border-blue-100 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        <span class="font-display tracking-wide uppercase text-[10px]">Artículos y Guías Prácticas</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl tracking-tight text-gray-900 mb-4">
        Blog de Lingüística y Finanzas
      </h1>
      <p class="font-sans text-gray-600 max-w-2xl mx-auto leading-relaxed text-sm sm:text-base">
        Aprende a redactar números y cantidades con total precisión académica, normativa mercantil y estilo para redes sociales.
      </p>
    </header>

    <!-- Articles List -->
    <div class="space-y-6">
      {BLOG_POSTS.map(post => (
        <article class="bg-white rounded-3xl border border-gray-100 shadow-xs hover:shadow-md hover:border-blue-200 transition-all overflow-hidden flex flex-col sm:flex-row group">
          {post.image && (
            <div class="sm:w-1/3 h-48 sm:h-auto relative overflow-hidden bg-gray-50 shrink-0">
              <Image 
                src={post.image} 
                alt={post.title}
                widths={[320, 480, 640, 768]}
                sizes="(max-width: 640px) calc(100vw - 2rem), 300px"
                loading="lazy"
                decoding="async"
                quality={75}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
          )}
          <div class="p-6 sm:p-8 flex flex-col justify-between flex-1">
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                  {post.category}
                </span>
                <span class="text-xs text-gray-400">•</span>
                <span class="text-xs text-gray-500 font-sans">{post.readTime}</span>
              </div>
              <h2 class="font-display font-bold text-lg sm:text-xl text-gray-900 group-hover:text-blue-600 transition-colors mb-2 leading-snug">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed line-clamp-3 mb-4 font-sans">
                {post.excerpt}
              </p>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-gray-100 text-xs">
              <span class="text-gray-400 font-sans">{post.date}</span>
              <a 
                href={`/blog/${post.slug}`}
                class="font-bold text-blue-600 hover:text-blue-800 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform"
              >
                <span>Leer artículo</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
