---
import { Image } from "astro:assets";
import { BLOG_POSTS } from '../../data/blog';
import Layout from '../../layouts/Layout.astro';
import BlogWidget from '../../components/BlogWidget';

export async function getStaticPaths() {
  return BLOG_POSTS.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const currentPath = `/blog/${post.slug}`;

const relatedPosts = BLOG_POSTS.filter(p => p.slug !== post.slug).slice(0, 2);

const imageSrc = post.image.src;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://numerosenletras.org${currentPath}`
  },
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": "2026-07-17T00:00:00+00:00",
  "dateModified": "2026-08-08T00:00:00+00:00",
  "author": {
    "@type": "Organization",
    "name": post.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "numerosenletras.org",
    "logo": {
      "@type": "ImageObject",
      "url": "https://numerosenletras.org/favicon.svg"
    }
  },
  "image": new URL(post.image.src, "https://numerosenletras.org").href
};

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Blog", path: "/blog" },
  { name: post.title, path: currentPath }
];
---

<Layout 
  title={`${post.title} | Blog numerosenletras.org`} 
  description={post.excerpt} 
  keywords={post.keywords.join(", ")} 
  currentPath={currentPath}
  schemaData={schemaData}
  image={imageSrc}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-4xl mx-auto px-4 py-8 sm:py-12 animate-fade-in text-left">
    <!-- Back to blog link -->
    <div class="mb-6">
      <a 
        href="/blog" 
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500 hover:text-blue-600 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Volver al blog</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 mb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
          {post.category}
        </span>
        <span class="text-xs text-gray-400">•</span>
        <time class="text-xs text-gray-500 font-sans">{post.date}</time>
        <span class="text-xs text-gray-400">•</span>
        <span class="text-xs text-gray-500 font-sans">{post.readTime}</span>
      </div>

      <h1 class="font-display font-extrabold text-2xl sm:text-3xl md:text-4xl text-gray-900 tracking-tight leading-tight">
        {post.title}
      </h1>

      <p class="text-base sm:text-lg text-gray-600 leading-relaxed font-sans">
        {post.excerpt}
      </p>

      <div class="flex items-center gap-3 pt-2 border-t border-gray-100 text-xs text-gray-500 font-sans">
        <span class="font-semibold text-gray-800">Por {post.author}</span>
        <span>•</span>
        <span>Revisado para normas RAE y formato financiero</span>
      </div>
    </header>

    <!-- Featured Image -->
    {post.image && (
      <div class="mb-8 rounded-3xl overflow-hidden border border-gray-100 shadow-sm bg-gray-50 max-h-96">
        <Image 
          src={post.image} 
          alt={post.title}
          widths={[480, 640, 768, 896, 1200]}
          sizes="(max-width: 896px) calc(100vw - 2rem), 896px"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          quality={78}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <!-- Interactive Island: Light mini converter/widget (Only for relevant interactive features) -->
    <BlogWidget slug={post.slug} client:visible />

    <!-- Static Article Content (Rendered by Astro directly, zero client JS) -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-xs p-6 sm:p-10 mb-10 prose prose-blue max-w-none text-gray-800 leading-relaxed">
      <div set:html={post.content} />
    </div>

    <!-- Keywords & Tags -->
    {post.keywords && post.keywords.length > 0 && (
      <div class="bg-gray-50/80 rounded-2xl p-5 border border-gray-100 mb-10">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider block mb-2 font-mono">
          Etiquetas y Temas Relacionados:
        </span>
        <div class="flex flex-wrap gap-1.5">
          {post.keywords.map(kw => (
            <span class="text-xs bg-white text-gray-700 px-2.5 py-1 rounded-lg border border-gray-200/60 font-sans">
              #{kw}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Related Articles (Astro static links) -->
    {relatedPosts.length > 0 && (
      <section class="border-t border-gray-100 pt-8">
        <h2 class="font-sans font-bold text-gray-900 text-lg mb-4">
          Artículos Relacionados
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedPosts.map(rel => (
            <a 
              href={`/blog/${rel.slug}`} 
              class="group bg-white p-5 rounded-2xl border border-gray-100 hover:border-blue-200 hover:shadow-sm transition-all block"
            >
              <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block mb-1">
                {rel.category}
              </span>
              <h3 class="font-bold text-sm text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-2 mb-2">
                {rel.title}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2">
                {rel.excerpt}
              </p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
