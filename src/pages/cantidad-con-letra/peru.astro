---
import Layout from '../../layouts/Layout.astro';
import QuantityConverter from '../../components/QuantityConverter';
import InterlinkingMatrix from '../../components/InterlinkingMatrix.astro';

const title = "Cantidad con Letra en Soles Peruanos | Convertidor PEN y Cheques";
const description = "Convierte cifras a soles peruanos con letra (PEN). Formato bancario con centavos fraccionarios (Y XX/100 SOLES) para cheques BCP, BBVA, facturas SUNAT y recibos en Perú.";
const currentPath = "/cantidad-con-letra/peru/";

const faqs = [
  {
    q: "¿El nombre oficial de la moneda de Perú es 'Sol' o 'Nuevo Sol'?",
    a: "Desde diciembre de 2015, mediante la Ley N° 30381 aprobada por el Congreso y reglamentada por el Banco Central de Reserva del Perú (BCRP), la denominación oficial es 'Sol' (plural: 'Soles') y el símbolo oficial es 'S/' sin punto intermedio ni final."
  },
  {
    q: "¿Cómo se escriben los céntimos en un cheque en Perú?",
    a: "La práctica bancaria uniforme en entidades peruanas (BCP, BBVA, Interbank, Scotiabank) es redactar la parte entera seguida del conector 'Y' y la fracción sobre cien: '... Y XX/100 SOLES'. Por ejemplo: 'Mil quinientos cuarenta Y 50/100 SOLES'."
  },
  {
    q: "¿Se escribe 'mil soles' o 'un mil soles' en cheques peruanos?",
    a: "En el español estándar de la RAE la forma canónica es 'mil soles'. No obstante, en la emisión de cheques en Perú es frecuente y aceptado escribir 'Un mil y 00/100 soles' con el fin de inhabilitar añadidos manuscritos fraudulentos."
  },
  {
    q: "¿Cómo se expresa un millón de soles con letra?",
    a: "Se redacta 'Un millón de soles y 00/100 soles' o bien 'Un millón de soles'. Al ser un millón exacto, se interpone la preposición 'de' antes del vocablo 'soles'."
  },
  {
    q: "¿Qué establece la Ley de Títulos Valores de Perú ante discrepancias de importes?",
    a: "Según la Ley N° 27287 (Ley de Títulos Valores de Perú), cuando exista discrepancia entre el monto expresado en números y el consignado en letras en un cheque o pagaré, prevalecerá la cantidad escrita en letras."
  }
];

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Convertidor de Cantidad con Letra en Soles Peruanos",
    "url": "https://numerosenletras.org/cantidad-con-letra/peru/",
    "description": description,
    "applicationCategory": "FinancialApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  }
];

const examples = [
  { num: "S/ 100.00", text: "Cien y 00/100 soles" },
  { num: "S/ 500.00", text: "Quinientos y 00/100 soles" },
  { num: "S/ 1,000.00", text: "Mil y 00/100 soles (o Un mil y 00/100 soles)" },
  { num: "S/ 1,500.00", text: "Mil quinientos y 00/100 soles" },
  { num: "S/ 1,540.50", text: "Mil quinientos cuarenta y 50/100 soles" },
  { num: "S/ 10,000.00", text: "Diez mil y 00/100 soles" },
  { num: "S/ 50,000.00", text: "Cincuenta mil y 00/100 soles" },
  { num: "S/ 100,000.00", text: "Cien mil y 00/100 soles" },
  { num: "S/ 1,000,000.00", text: "Un millón y 00/100 soles" },
  { num: "S/ 2,450.75", text: "Dos mil cuatrocientos cincuenta y 75/100 soles" }
];
---

<Layout title={title} description={description} currentPath={currentPath} schemaData={schemaData}>
  <div class="relative max-w-4xl mx-auto px-4 py-8 sm:py-14 animate-fade-in">
    <!-- Header -->
    <header class="text-center mb-8 relative">
      <div class="inline-flex items-center space-x-2 bg-emerald-50 text-emerald-700 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-3 border border-emerald-100 shadow-xs">
        <span class="text-base">🇵🇪</span>
        <span class="font-display tracking-wide uppercase text-[10px]">Formato Bancario para Perú (PEN)</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl tracking-tight text-gray-900 mb-3">
        Cantidad con Letra en Soles Peruanos
      </h1>
      <p class="font-sans text-gray-600 max-w-2xl mx-auto leading-relaxed text-sm sm:text-base">
        Genera la redacción canónica para cheques bancarios, contratos mercantiles y comprobantes electrónicos de pago conforme a las pautas de la SUNAT y el BCRP en Perú.
      </p>
    </header>

    <!-- Quick Direct Answer (GEO / AI Overview optimized) -->
    <section class="mb-8 bg-emerald-50/70 border border-emerald-200/80 rounded-2xl p-4 sm:p-5 text-left">
      <div class="flex items-start gap-3">
        <span class="p-1.5 bg-emerald-600 text-white rounded-lg text-xs font-mono font-bold mt-0.5 shrink-0">Respuesta rápida</span>
        <div class="space-y-1">
          <p class="text-xs sm:text-sm font-semibold text-emerald-950">
            ¿Cómo se escribe una cantidad con letra en soles peruanos?
          </p>
          <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed font-sans">
            La fórmula estandarizada en cheques peruanos consiste en escribir la cifra entera en letras seguida de <strong>"Y XX/100 SOLES"</strong>.<br />
            Ejemplo: <strong>S/ 1,540.50 PEN</strong> se redacta: <em>«Mil quinientos cuarenta y 50/100 soles»</em> (o en cheques: <em>«Mil quinientos cuarenta Y 50/100 SOLES»</em>).
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive Tool Island -->
    <QuantityConverter client:load initialCurrency="PEN" initialAmount="1540.50" />

    <!-- Practical Formatting Guide -->
    <article class="mt-12 bg-white rounded-3xl border border-gray-150 p-6 sm:p-8 text-left space-y-8 shadow-xs">
      <div class="border-b border-gray-150 pb-4">
        <h2 class="font-display font-bold text-gray-950 text-xl sm:text-2xl">
          Estructura y Normativa Financiera en el Perú
        </h2>
        <p class="text-xs text-gray-500 mt-1">
          Directrices para la emisión de títulos valores, letras de cambio y facturas electrónicas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-600">
        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">1. La Fórmula "Y XX/100 SOLES"</h3>
          <p class="text-xs leading-relaxed">
            En los cheques emitidos en el Perú (Banco de Crédito del Perú BCP, BBVA, Interbank, BanBif), el campo del importe con letra culmina tradicionalmente con la conjunción <strong>"Y"</strong>, la fracción de céntimos sobre cien y el nombre de la divisa en mayúsculas:
          </p>
          <div class="bg-gray-50 p-3 rounded-xl border border-gray-200 font-mono text-xs text-gray-800">
            ... Y 00/100 SOLES
          </div>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">2. Símbolo Monetario Oficial (S/)</h3>
          <p class="text-xs leading-relaxed">
            Según la Ley N° 30381 del BCRP, el símbolo monetario de la divisa peruana es <strong>S/</strong>. Debe escribirse con espacio entre el signo y la cifra (ej. <em>S/ 1,500.00</em>) y sin ningún punto entre la letra S y la barra.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">3. Uso de "Un mil" en Títulos Valores Peruanos</h3>
          <p class="text-xs leading-relaxed">
            Si bien la RAE prescribe redactar <em>mil</em>, en letras de cambio y pagarés bancarios peruanos se acepta <strong>"Un mil"</strong> para neutralizar cualquier adulteración o espacio en blanco previo.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">4. Separador Decimal en Perú</h3>
          <p class="text-xs leading-relaxed">
            En el ámbito financiero y contable peruano se emplea con frecuencia la coma para separar millares y el punto para decimales (ej. <em>S/ 2,450.50</em>), aunque la norma metrológica nacional admite también el uso de la coma decimal.
          </p>
        </div>
      </div>

      <!-- Conversion Examples Table -->
      <div class="space-y-4 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">
          Tabla de Cantidades Frecuentes en Soles (PEN)
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border border-gray-200 rounded-xl overflow-hidden">
            <thead class="bg-gray-50 text-gray-700 font-semibold border-b border-gray-200">
              <tr>
                <th class="p-3">Importe en Cifra</th>
                <th class="p-3">Cantidad con Letra (Formato Bancario Perú)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-mono">
              {examples.map((item, idx) => (
                <tr class={idx % 2 === 0 ? "bg-white" : "bg-gray-50/50"}>
                  <td class="p-3 font-bold text-gray-900 whitespace-nowrap">{item.num}</td>
                  <td class="p-3 text-gray-700 font-sans">{item.text}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Common Mistakes -->
      <div class="space-y-3 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">Errores Habituales en Textos Mercantiles Peruanos</h3>
        <ul class="list-disc pl-5 space-y-1.5 text-xs text-gray-600 leading-relaxed font-sans">
          <li><strong>Escribir "Nuevos Soles":</strong> La moneda oficial se llama legalmente "Sol" desde fines de 2015.</li>
          <li><strong>Colocar punto en el símbolo (S/.):</strong> El símbolo legalmente vigente ante el BCRP es <em>S/</em> sin punto.</li>
          <li><strong>Olvidar indicar céntimos fraccionarios:</strong> En cheques se debe colocar expresamente <em>00/100</em> cuando no hay céntimos.</li>
        </ul>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-4 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">Preguntas Frecuentes sobre Importes en Soles</h3>
        <div class="space-y-3">
          {faqs.map((faq, index) => (
            <details class="group border border-gray-150 rounded-xl open:border-emerald-300 open:bg-emerald-50/15 transition-all p-3.5" open={index === 0}>
              <summary class="font-semibold text-xs sm:text-sm text-gray-800 cursor-pointer list-none flex justify-between items-center">
                <span>{faq.q}</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform text-xs ml-2">▼</span>
              </summary>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed border-t border-gray-150/60 pt-2 font-sans">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>

      <!-- Sources and Revision -->
      <div class="pt-6 border-t border-gray-150 space-y-2 text-xs text-gray-500 font-sans">
        <h4 class="font-bold text-gray-800 text-xs uppercase tracking-wider font-mono">Fuentes consultadas</h4>
        <ul class="list-disc pl-5 space-y-1 text-[11px]">
          <li>
            <a href="https://www.bcrp.gob.pe/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Banco Central de Reserva del Perú (BCRP) - Ley N° 30381 (Cambio de denominación de la unidad monetaria a Sol)
            </a>
          </li>
          <li>
            <a href="https://www.leyes.congreso.gob.pe/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Congreso de la República del Perú - Ley N° 27287 (Ley de Títulos Valores)
            </a>
          </li>
          <li>
            <a href="https://www.rae.es/dpd/cardinales" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Real Academia Española - Diccionario panhispánico de dudas (Ortografía de cifras)
            </a>
          </li>
        </ul>
        <p class="text-[11px] text-gray-400 pt-2 font-mono">
          Última revisión: septiembre de 2026. Documento informativo orientado a la correcta transcripción literal de importes.
        </p>
      </div>
    </article>

    <!-- Contextual Interlinking Matrix -->
    <InterlinkingMatrix currentPath={currentPath} />
  </div>
</Layout>
