---
import Layout from '../../layouts/Layout.astro';
import QuantityConverter from '../../components/QuantityConverter';
import InterlinkingMatrix from '../../components/InterlinkingMatrix.astro';

const title = "Cantidad con Letra en Pesos Colombianos | Convertidor COP y Cheques";
const description = "Convierte cifras a pesos colombianos con letra (COP). Formato habitual con 'M/CTE' (Moneda Corriente) y centavos para cheques bancarios, contratos y facturas DIAN en Colombia.";
const currentPath = "/cantidad-con-letra/colombia/";

const faqs = [
  {
    q: "¿Qué significa la abreviatura 'M/CTE' en cheques y recibos de Colombia?",
    a: "Significa 'Moneda Corriente'. Es una expresión legal y comercial arraigada en Colombia para ratificar que la suma se liquida en la divisa de curso legal del país (pesos colombianos) y no en moneda extranjera."
  },
  {
    q: "¿Se siguen utilizando centavos en cheques y contratos colombianos?",
    a: "En transacciones comerciales corrientes los centavos son poco frecuentes debido a la escala del peso colombiano; sin embargo, en documentos jurídicos, contables, cheques y liquidaciones tributarias de la DIAN se redacta habitualmente '... pesos M/CTE' o bien '... pesos con XX centavos' o la fracción 'XX/100 M/CTE'."
  },
  {
    q: "¿Cómo se escribe un millón de pesos en Colombia?",
    a: "Se escribe 'Un millón de pesos M/CTE'. Al tratarse de un múltiplo exacto de millón sin millares intermedios, la gramática de la RAE exige la preposición 'de' antes del nombre de la moneda."
  },
  {
    q: "¿En Colombia se escribe 'mil pesos' o 'un mil pesos' en cheques?",
    a: "La norma académica general recomienda escribir 'mil pesos'. Sin embargo, en notarías, despachos de abogados y entidades financieras colombianas (Bancolombia, Banco de Bogotá, Davivienda) se acostumbra usar 'un mil pesos' en cheques para proteger el documento frente a adulteraciones."
  },
  {
    q: "¿Qué prevalece en Colombia si la cifra en números no coincide con las letras?",
    a: "De acuerdo con el Código de Comercio de Colombia (Artículo 623), si el importe del título valor se encuentra expresado en palabras y en cifras y existe diferencia entre una y otra mención, valdrá la suma escrita en palabras."
  }
];

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Convertidor de Cantidad con Letra en Pesos Colombianos",
    "url": "https://numerosenletras.org/cantidad-con-letra/colombia/",
    "description": description,
    "applicationCategory": "FinancialApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  }
];

const examples = [
  { num: "$100 COP", text: "Cien pesos M/CTE" },
  { num: "$1.000 COP", text: "Mil pesos M/CTE (o Un mil pesos M/CTE)" },
  { num: "$50.000 COP", text: "Cincuenta mil pesos M/CTE" },
  { num: "$100.000 COP", text: "Cien mil pesos M/CTE" },
  { num: "$500.000 COP", text: "Quinientos mil pesos M/CTE" },
  { num: "$1.000.000 COP", text: "Un millón de pesos M/CTE" },
  { num: "$1.500.000 COP", text: "Un millón quinientos mil pesos M/CTE" },
  { num: "$5.000.000 COP", text: "Cinco millones de pesos M/CTE" },
  { num: "$10.250.000 COP", text: "Diez millones doscientos cincuenta mil pesos M/CTE" },
  { num: "$1.540,50 COP", text: "Mil quinientos cuarenta pesos con cincuenta centavos M/CTE (o 50/100 M/CTE)" }
];
---

<Layout title={title} description={description} currentPath={currentPath} schemaData={schemaData}>
  <div class="relative max-w-4xl mx-auto px-4 py-8 sm:py-14 animate-fade-in">
    <!-- Header -->
    <header class="text-center mb-8 relative">
      <div class="inline-flex items-center space-x-2 bg-emerald-50 text-emerald-700 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-3 border border-emerald-100 shadow-xs">
        <span class="text-base">🇨🇴</span>
        <span class="font-display tracking-wide uppercase text-[10px]">Formato Bancario para Colombia (COP)</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl tracking-tight text-gray-900 mb-3">
        Cantidad con Letra en Pesos Colombianos
      </h1>
      <p class="font-sans text-gray-600 max-w-2xl mx-auto leading-relaxed text-sm sm:text-base">
        Escribe cualquier cifra en pesos colombianos con la terminología formal aplicable a cheques, pagarés, contratos de arrendamiento y facturación electrónica DIAN.
      </p>
    </header>

    <!-- Quick Direct Answer (GEO / AI Overview optimized) -->
    <section class="mb-8 bg-emerald-50/70 border border-emerald-200/80 rounded-2xl p-4 sm:p-5 text-left">
      <div class="flex items-start gap-3">
        <span class="p-1.5 bg-emerald-600 text-white rounded-lg text-xs font-mono font-bold mt-0.5 shrink-0">Respuesta rápida</span>
        <div class="space-y-1">
          <p class="text-xs sm:text-sm font-semibold text-emerald-950">
            ¿Cómo se escribe una cantidad con letra en pesos colombianos?
          </p>
          <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed font-sans">
            Se escribe el valor en letras mayúsculas o minúsculas, seguido del sustantivo <strong>"pesos"</strong> y la sigla <strong>M/CTE</strong> (Moneda Corriente).<br />
            Ejemplo: <strong>$1.500.000 COP</strong> se redacta: <em>«Un millón quinientos mil pesos M/CTE»</em>. Si incluye centavos, se añade <em>«con XX centavos M/CTE»</em> o la fracción <em>«XX/100 M/CTE»</em>.
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive Tool Island -->
    <QuantityConverter client:load initialCurrency="COP" initialAmount="1500000" />

    <!-- Practical Formatting Guide -->
    <article class="mt-12 bg-white rounded-3xl border border-gray-150 p-6 sm:p-8 text-left space-y-8 shadow-xs">
      <div class="border-b border-gray-150 pb-4">
        <h2 class="font-display font-bold text-gray-950 text-xl sm:text-2xl">
          Particularidades de la Redacción Financiera en Colombia
        </h2>
        <p class="text-xs text-gray-500 mt-1">
          Criterios mercantiles y contables comunes en cheques de entidades bancarias colombianas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-600">
        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">1. La Cláusula "M/CTE" (Moneda Corriente)</h3>
          <p class="text-xs leading-relaxed">
            En Colombia es práctica unánime en recibos, pagarés y cheques corporativos colocar la indicación <strong>M/CTE</strong> al cierre de la redacción para declarar que la obligación se extingue en la moneda legal colombiana.
          </p>
          <div class="bg-gray-50 p-3 rounded-xl border border-gray-200 font-mono text-xs text-gray-800">
            ... quinientos mil pesos M/CTE.
          </div>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">2. ¿Cómo se tratan los Millones en Colombia?</h3>
          <p class="text-xs leading-relaxed">
            En cifras de siete o más dígitos, cuando el millón es cerrado se intercala "de": <em>Cinco millones <strong>de</strong> pesos M/CTE</em>. Si le siguen miles, la preposición desaparece: <em>Cinco millones doscientos mil pesos M/CTE</em>.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">3. Uso de "Un mil" en Chequeras Colombianas</h3>
          <p class="text-xs leading-relaxed">
            Aunque la RAE aconseja escribir sencillamente <em>mil</em>, en el sector financiero colombiano (Bancolombia, Davivienda, BBVA Colombia) muchas instituciones sugieren redactar <strong>"Un mil pesos"</strong> en cheques impresos o manuscritos para anular espacios en blanco.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">4. Separadores Numéricos</h3>
          <p class="text-xs leading-relaxed">
            En Colombia suele emplearse el punto (.) como separador de millares y la coma (,) para decimales (ej. $1.500.000,00), aunque en sistemas informáticos también se observa el formato anglosajón.
          </p>
        </div>
      </div>

      <!-- Conversion Examples Table -->
      <div class="space-y-4 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">
          Tabla de Cantidades Frecuentes en Pesos Colombianos (COP)
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border border-gray-200 rounded-xl overflow-hidden">
            <thead class="bg-gray-50 text-gray-700 font-semibold border-b border-gray-200">
              <tr>
                <th class="p-3">Importe en Cifra</th>
                <th class="p-3">Cantidad con Letra (Formato Colombiano)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-mono">
              {examples.map((item, idx) => (
                <tr class={idx % 2 === 0 ? "bg-white" : "bg-gray-50/50"}>
                  <td class="p-3 font-bold text-gray-900 whitespace-nowrap">{item.num}</td>
                  <td class="p-3 text-gray-700 font-sans">{item.text}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Common Mistakes -->
      <div class="space-y-3 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">Errores Habituales en Textos Mercantiles Colombianos</h3>
        <ul class="list-disc pl-5 space-y-1.5 text-xs text-gray-600 leading-relaxed font-sans">
          <li><strong>Escribir "veinte y dos" en lugar de "veintidós":</strong> Hasta el 29 se escriben unificados con tilde según las reglas de acentuación.</li>
          <li><strong>Omitir la sigla M/CTE:</strong> En cheques bancarios sin esta especificación pueden surgir requerimientos adicionales de confirmación.</li>
          <li><strong>Discrepancia entre números y letras:</strong> Recuerda que ante divergencias, el Código de Comercio colombiano prioriza el texto con letra.</li>
        </ul>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-4 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">Preguntas Frecuentes sobre Importes en Colombia</h3>
        <div class="space-y-3">
          {faqs.map((faq, index) => (
            <details class="group border border-gray-150 rounded-xl open:border-emerald-300 open:bg-emerald-50/15 transition-all p-3.5" open={index === 0}>
              <summary class="font-semibold text-xs sm:text-sm text-gray-800 cursor-pointer list-none flex justify-between items-center">
                <span>{faq.q}</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform text-xs ml-2">▼</span>
              </summary>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed border-t border-gray-150/60 pt-2 font-sans">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>

      <!-- Sources and Revision -->
      <div class="pt-6 border-t border-gray-150 space-y-2 text-xs text-gray-500 font-sans">
        <h4 class="font-bold text-gray-800 text-xs uppercase tracking-wider font-mono">Fuentes consultadas</h4>
        <ul class="list-disc pl-5 space-y-1 text-[11px]">
          <li>
            <a href="https://www.secretariasenado.gov.co/senado/basedoc/codigo_comercio_pr019.html" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Secretaría del Senado de Colombia - Código de Comercio (Artículo 623 sobre Títulos Valores)
            </a>
          </li>
          <li>
            <a href="https://www.banrep.gov.co/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Banco de la República de Colombia - Información y normativa sobre la moneda legal
            </a>
          </li>
          <li>
            <a href="https://www.rae.es/dpd/cardinales" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Real Academia Española - Diccionario panhispánico de dudas (Escritura de numerales)
            </a>
          </li>
        </ul>
        <p class="text-[11px] text-gray-400 pt-2 font-mono">
          Última revisión: septiembre de 2026. Guía informativa para redacción mercantil y contable.
        </p>
      </div>
    </article>

    <!-- Contextual Interlinking Matrix -->
    <InterlinkingMatrix currentPath={currentPath} />
  </div>
</Layout>
