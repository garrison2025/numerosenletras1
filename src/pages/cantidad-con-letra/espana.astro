---
import Layout from '../../layouts/Layout.astro';
import QuantityConverter from '../../components/QuantityConverter';
import { getCountryExamples } from '../../utils/countryFinancialFormats.js';

const title = "Cantidad con Letra en Euros | Convertidor EUR para España y Cheques";
const description = "Convierte cifras a euros con letra (EUR). Formato bancario estándar con céntimos y fracciones para cheques bancarios, pagarés, contratos de alquiler y facturas en España.";
const currentPath = "/cantidad-con-letra/espana/";

const faqs = [
  {
    q: "¿Cómo se escriben los céntimos en un cheque en España?",
    a: "En cheques y pagarés bancarios en España es habitual redactar la parte entera en letras, seguida de 'euros', y expresar los céntimos como 'con XX céntimos' o en formato fraccionario 'con XX/100'. Por ejemplo: 'Mil quinientos cuarenta euros con cincuenta céntimos'."
  },
  {
    q: "¿Qué establece la legislación española si difiere la cantidad en letras de la cantidad en números?",
    a: "De acuerdo con el Artículo 115 de la Ley 19/1985, de 16 de julio, Cambiaria y del Cheque de España, si en el cheque figurase el importe escrito en letras y en cifras, será válida la cantidad escrita en letras en caso de discrepancia."
  },
  {
    q: "¿Se escribe 'mil euros' o 'un mil euros' en cheques españoles?",
    a: "La Real Academia Española (RAE) prescribe que en la lengua general culta debe escribirse únicamente 'mil euros'. A pesar de ello, en la práctica mercantil, notarial y bancaria española a veces se emplea 'un mil euros' para evitar agregados en cheques manuscritos."
  },
  {
    q: "¿Cómo se escribe un millón de euros?",
    a: "Se escribe 'Un millón de euros'. Al tratarse de un múltiplo exacto de millón, la norma gramatical exige interponer la preposición 'de' entre el numeral 'millón' y el sustantivo 'euros'."
  },
  {
    q: "¿Cuál es el separador decimal estándar en España?",
    a: "En España se utiliza la coma (,) como separador decimal oficial y el punto (.) o el espacio para agrupar las cifras de tres en tres (por ejemplo: 1.540,50 €)."
  }
];

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Convertidor de Cantidad con Letra en Euros (España)",
    "url": "https://numerosenletras.org/cantidad-con-letra/espana/",
    "description": description,
    "applicationCategory": "FinancialApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  }
];

const examples = getCountryExamples('ES');
---

<Layout title={title} description={description} currentPath={currentPath} schemaData={schemaData}>
  <div class="relative max-w-4xl mx-auto px-4 py-8 sm:py-14 animate-fade-in">
    <!-- Header -->
    <header class="text-center mb-8 relative">
      <div class="inline-flex items-center space-x-2 bg-emerald-50 text-emerald-700 px-3.5 py-1.5 rounded-full text-xs font-semibold mb-3 border border-emerald-100 shadow-xs">
        <span class="text-base">🇪🇸</span>
        <span class="font-display tracking-wide uppercase text-[10px]">Formato Bancario para España (EUR)</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl tracking-tight text-gray-900 mb-3">
        Cantidad con Letra en Euros
      </h1>
      <p class="font-sans text-gray-600 max-w-2xl mx-auto leading-relaxed text-sm sm:text-base">
        Escribe importes en euros y céntimos con las normas gramaticales de la RAE y las exigencias de la Ley Cambiaria y del Cheque aplicadas en España.
      </p>
    </header>

    <!-- Quick Direct Answer (GEO / AI Overview optimized) -->
    <section class="mb-8 bg-emerald-50/70 border border-emerald-200/80 rounded-2xl p-4 sm:p-5 text-left">
      <div class="flex items-start gap-3">
        <span class="p-1.5 bg-emerald-600 text-white rounded-lg text-xs font-mono font-bold mt-0.5 shrink-0">Respuesta rápida</span>
        <div class="space-y-1">
          <p class="text-xs sm:text-sm font-semibold text-emerald-950">
            ¿Cómo se escribe una cantidad con letra en euros?
          </p>
          <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed font-sans">
            La fórmula formal consiste en escribir la cantidad entera en letras, seguida del sustantivo <strong>"euros"</strong> y los decimales redactados como <strong>"con XX céntimos"</strong> o en fracción <strong>"con XX/100"</strong>.<br />
            Ejemplo: <strong>1.540,50 €</strong> se escribe: <em>«Mil quinientos cuarenta euros con cincuenta céntimos»</em>.
          </p>
        </div>
      </div>
    </section>

    <!-- Interactive Tool Island -->
    <QuantityConverter client:load initialCurrency="EUR" initialAmount="1540,50" initialCity="Madrid" initialNumberFormatStyle="ES" />

    <!-- Practical Formatting Guide -->
    <article class="mt-12 bg-white rounded-3xl border border-gray-150 p-6 sm:p-8 text-left space-y-8 shadow-xs">
      <div class="border-b border-gray-150 pb-4">
        <h2 class="font-display font-bold text-gray-950 text-xl sm:text-2xl">
          Estructura de Redacción Mercantil en Euros (España)
        </h2>
        <p class="text-xs text-gray-500 mt-1">
          Reglas lingüísticas de la RAE y requisitos de pagarés y cheques según la legislación cambiaria española.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-gray-600">
        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">1. Expresión de Céntimos</h3>
          <p class="text-xs leading-relaxed">
            La moneda fraccionaria oficial del euro en la Unión Europea es el <strong>céntimo de euro</strong>. En cheques y pagarés se expresa redactando "con XX céntimos" o mediante la fracción clásica sobre cien:
          </p>
          <div class="bg-gray-50 p-3 rounded-xl border border-gray-200 font-mono text-xs text-gray-800">
            ... euros con cincuenta céntimos (o con 50/100)
          </div>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">2. ¿"Mil" o "Un mil" en España?</h3>
          <p class="text-xs leading-relaxed">
            La RAE recomienda inequívocamente escribir <em>mil euros</em> sin anteponer el numeral <em>un</em>. Sin embargo, en el llenado manual de pagarés de empresa, chequeras bancarias y escrituras notariales, a menudo se añade <em>un</em> para evitar que se intercalen palabras espurias.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">3. Uso de la Preposición "de" con Millones</h3>
          <p class="text-xs leading-relaxed">
            Cuando la suma de millones es redonda (ej. 3.000.000 €), debe colocarse "de": <em>Tres millones <strong>de</strong> euros</em>. Si la cifra tiene millares intermedios (ej. 3.500.000 €), no se utiliza la preposición: <em>Tres millones quinientos mil euros</em>.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-gray-900 text-sm">4. Separadores Numéricos y Símbolo del Euro</h3>
          <p class="text-xs leading-relaxed">
            En España, la norma ortográfica de la RAE y las directivas de la UE establecen que el símbolo <strong>€</strong> debe colocarse pospuesto a la cifra y separado por un espacio fino o estándar (ej. <em>1.500,50 €</em>).
          </p>
        </div>
      </div>

      <!-- Conversion Examples Table -->
      <div class="space-y-4 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">
          Tabla de Cantidades Frecuentes en Euros (EUR)
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border border-gray-200 rounded-xl overflow-hidden">
            <thead class="bg-gray-50 text-gray-700 font-semibold border-b border-gray-200">
              <tr>
                <th class="p-3">Importe en Cifra</th>
                <th class="p-3">Cantidad con Letra (Formato España)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 font-mono">
              {examples.map((item, idx) => (
                <tr class={idx % 2 === 0 ? "bg-white" : "bg-gray-50/50"}>
                  <td class="p-3 font-bold text-gray-900 whitespace-nowrap">{item.num}</td>
                  <td class="p-3 text-gray-700 font-sans">{item.text} {item.variant ? <span class="text-gray-400 text-[11px]">({item.variant})</span> : ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Common Mistakes -->
      <div class="space-y-3 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">Errores Habituales en Documentos Financieros Españoles</h3>
        <ul class="list-disc pl-5 space-y-1.5 text-xs text-gray-600 leading-relaxed font-sans">
          <li><strong>Escribir el símbolo € antes de la cifra:</strong> En el uso hispánico el símbolo se coloca detrás de la cifra separado por un espacio (<em>100 €</em>, no <em>€100</em>).</li>
          <li><strong>Separar las cifras del 21 al 29:</strong> Deben escribirse en una sola palabra: <em>veintitrés</em>, <em>veintiséis</em>, etc.</li>
          <li><strong>Discrepancia en pagarés:</strong> Ante divergencias entre letras y números, el Artículo 115 de la Ley Cambiaria valida el importe escrito en letras.</li>
        </ul>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-4 pt-4 border-t border-gray-150">
        <h3 class="font-bold text-gray-900 text-base">Preguntas Frecuentes sobre Importes en Euros</h3>
        <div class="space-y-3">
          {faqs.map((faq, index) => (
            <details class="group border border-gray-150 rounded-xl open:border-emerald-300 open:bg-emerald-50/15 transition-all p-3.5" open={index === 0}>
              <summary class="font-semibold text-xs sm:text-sm text-gray-800 cursor-pointer list-none flex justify-between items-center">
                <span>{faq.q}</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform text-xs ml-2">▼</span>
              </summary>
              <p class="text-xs text-gray-600 mt-2 leading-relaxed border-t border-gray-150/60 pt-2 font-sans">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>

      <!-- Sources and Revision -->
      <div class="pt-6 border-t border-gray-150 space-y-2 text-xs text-gray-500 font-sans">
        <h4 class="font-bold text-gray-800 text-xs uppercase tracking-wider font-mono">Fuentes consultadas</h4>
        <ul class="list-disc pl-5 space-y-1 text-[11px]">
          <li>
            <a href="https://www.boe.es/buscar/act.php?id=BOE-A-1985-14880" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Boletín Oficial del Estado (BOE) - Ley 19/1985, de 16 de julio, Cambiaria y del Cheque (Artículo 115)
            </a>
          </li>
          <li>
            <a href="https://www.bde.es/" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Banco de España - Portal del Cliente Bancario (Emisión de cheques y pagarés)
            </a>
          </li>
          <li>
            <a href="https://www.rae.es/dpd/cardinales" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
              Real Academia Española - Diccionario panhispánico de dudas (Ortografía de números cardinales)
            </a>
          </li>
        </ul>
        <p class="text-[11px] text-gray-400 pt-2 font-mono">
          Última revisión: septiembre de 2026. Documentación orientativa para la correcta redacción de importes en cheques y pagarés.
        </p>
        <p class="text-[11px] text-gray-500 italic mt-3 pt-3 border-t border-gray-150/70 font-sans leading-relaxed">
          «La información y ejemplos presentados en esta página tienen carácter meramente orientativo e ilustrativo. Para la suscripción o emisión de cheques, pagarés u otros títulos valores de valor vinculante, verifique siempre las directivas particulares de su entidad bancaria y la normativa mercantil aplicable.»
        </p>
      </div>
    </article>
  </div>
</Layout>
